# Security headers for the static site (Cloudflare Pages).
#
# The Worker sets its own headers on API responses; these cover the pages themselves, which the
# Worker never touches. Without this file the app shell would ship with no CSP at all — the API
# would be hardened and the thing people actually load would not be.
#
# The policy mirrors apps/worker/src/security.ts. Tile and map hosts are not listed because the
# map only loads a style when one is configured; if a tile host is added, add it in both places.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self' data:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed assets are immutable, so they can be cached hard. The shell must not be, or a deploy
# would not reach anyone still holding the previous index.html.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=3600
