# Bus Stops. — environment template.
#
# Names only, never values. Copy to .env for local development; set the same names as platform
# secrets (GitHub Actions, Cloudflare Worker) in each environment.
#
# infra/cloudflare/PROVISIONING.md is the authoritative list of what goes where — this file says
# what each name is for; that file says whether it is a repository secret, a repository variable
# or a Worker secret, and which are required.
#
# Every name below is read by shipped code or by a workflow in .github/workflows. Nothing here is
# aspirational: if a variable is absent, exactly one capability degrades and the rest of the
# platform runs unaffected.

# --- Upstream data sources ---------------------------------------------------
# Bus Open Data Service (England outside London). Register: https://data.bus-data.dft.gov.uk/
# Read by: the Worker (live vehicles) and the collection/static-network jobs.
# Consumer guidance asks for no more than one central live-data request every five seconds; that
# interval is enforced in code, not merely documented.
BODS_API_KEY=

# TfL Unified API (London). Register: https://api-portal.tfl.gov.uk/
# Read by: the Worker (London arrivals) and the static-network jobs.
# The registered product is rate limited to 500 requests per minute.
TFL_APP_KEY=

# Open-Meteo, the Environment Agency flood API and OpenStreetMap need no key.
# National Highways and Street Manager adapters are implemented and contract-tested but are not
# yet called by any scheduled job, so they need no credential to deploy. When a job starts using
# them, add their key names here, to the source registry entry, and to that job's workflow.

# --- Cloudflare --------------------------------------------------------------
# Used by wrangler (deployment) and by the scheduled jobs that read and write R2 over the REST
# API. The token needs only the four scopes listed in PROVISIONING.md.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Artifact bucket the scheduled jobs read and write. Must match the bucket_name in
# apps/worker/wrangler.toml for the environment being deployed.
R2_BUCKET_ARTIFACTS=busstops-artifacts

# --- Vehicle reference privacy -----------------------------------------------
# Secret behind the daily rotating salt applied to upstream vehicle references. Rotating the salt
# per service day means a published reference cannot be correlated across days, so the stored data
# describes traffic conditions rather than tracking individual vehicles. Collection refuses to run
# without it rather than storing operator identifiers unsalted.
VEHICLE_SALT_SECRET=

# --- Email (Daily Brief) -----------------------------------------------------
# All optional. With none of these set the Daily Brief snapshot is still built and published and
# the browser view works normally; only email delivery is skipped.
EMAIL_PROVIDER=
EMAIL_PROVIDER_ENDPOINT=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# Secret behind one-click unsubscribe tokens. Only token hashes are stored, so a leaked backup
# cannot be used to unsubscribe anyone or reversed into a list of addresses.
UNSUBSCRIBE_SECRET=

# --- Public URLs -------------------------------------------------------------
# Where the deployed app lives. Used for links in the Daily Brief, and as the Worker's CORS
# allow-list (declared per environment in wrangler.toml [vars], because the Pages hostname is
# deterministic). Public by definition, so a repository variable rather than a secret.
PUBLIC_BASE_URL=

# The API origin the frontend is compiled against. Baked into the bundle at build time by the
# deploy workflows, which read it back from the Worker that was just deployed rather than from
# configuration that could point somewhere else. Left unset the client falls back to a relative
# /api, which is what the Vite dev server proxies to a local wrangler.
VITE_API_URL=

# --- Runtime configuration ---------------------------------------------------
# Kill switches and a forced governor state for drills. Declared in wrangler.toml [vars] for the
# Worker; set here only for local development.
FEATURE_FLAGS_JSON={}
GOVERNOR_MODE=green

# --- Scheduled job tuning (all optional; each has a default in the job) -------
# Current budget utilisation, 0..1. The scheduled jobs cannot see the Cloudflare dashboard, so
# this is how they learn to widen their cadence or suspend before a limit is reached.
BUDGET_UTILIZATION=

# Partitions collected per run. England is tiled into 24; the default of 12 keeps a run inside
# both its time budget and the five-second request interval.
MAX_PARTITIONS_PER_RUN=

# Ceiling on BODS requests per day. Defaults to 8,640 — half of the 17,280 implied by one request
# every five seconds. BODS publishes no daily quota, so a larger figure would be invented.
BODS_DAILY_REQUEST_BUDGET=

# Snapshots per collection run. One position per vehicle cannot yield a traversal or a speed.
COLLECTION_PASSES=

# Wall-clock ceilings, in milliseconds, so a scheduled job cannot overrun its slot.
COLLECTION_BUDGET_MS=
BATCH_BUDGET_MS=

# R2 storage limit in bytes, used by the retention job to project when storage would fill.
R2_STORAGE_LIMIT_BYTES=

# Rebuild the national network even when no source fingerprint changed.
FORCE_REBUILD=

# PREFLIGHT_STAGE is not set here. It is set to "deploy" by the Deploy workflow to switch
# scripts/preflight.mjs from warning to failing on deploy-only gates; setting it locally would
# only make `npm run preflight` stricter than CI.

# Path to a Chromium binary that is already installed, used by the Playwright projects and by
# scripts/visual-qa.mjs. Set it when the image carries a browser whose revision differs from the
# one Playwright expects; leave it empty and Playwright uses the copy it downloaded.
CHROMIUM_PATH=

# Which BODS GTFS timetable extract a national build reads. "all" is the national archive;
# the regional slugs ("yorkshire", "north_west", ...) are smaller and fail independently, so a
# build that loses one region still publishes the others. Defaults to "all".
#
# There is no dataset cap any more. The old BODS_MAX_TIMETABLE_DATASETS took the first N of 945
# published archives and was really a memory limit — everything fetched was assembled into one
# in-memory network — which is why a national map had a departure board at some stops and none at
# others. The archive is now read as a stream and the journeys spill to disk, so the whole of it
# is ingested.
BODS_GTFS_REGION=

# Minutes between weather collections, used by the scheduled job to prove its own schedule fits
# Open-Meteo's free non-commercial allowance. It must match the cron in
# .github/workflows/weather.yml: the job computes requests-per-day from this number and refuses to
# run a schedule that would not fit, so a cron changed without this is a check against fiction.
WEATHER_REFRESH_MINUTES=
