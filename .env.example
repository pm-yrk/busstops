# Bus Stops. — environment template.
# Never commit real values. Copy to .env for local dev; set the same names as
# platform secrets (Cloudflare Pages/Workers, GitHub Actions) in each environment.

# --- Upstream data sources ---
# Bus Open Data Service (England outside London). Register: https://data.bus-data.dft.gov.uk/
BODS_API_KEY=

# TfL Unified API (London). Register: https://api-portal.tfl.gov.uk/
TFL_APP_KEY=

# National Highways / WebTRIS developer feeds (strategic road network).
NATIONAL_HIGHWAYS_API_KEY=

# Street Manager (street/road works). Register: https://department-for-transport-streetmanager.github.io/street-manager-docs/
STREET_MANAGER_API_KEY=

# Open-Meteo: no key required (public, rate-limited).
# Environment Agency flood API: no key required (public, rate-limited).
# OpenStreetMap: no key required; respect usage policy, no heavy tile/routing load.

# --- Cloudflare platform ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET_ARTIFACTS=busstops-artifacts
R2_BUCKET_RAW=busstops-raw-window
KV_NAMESPACE_CACHE=

# --- Account/preferences store (minimal; accounts + org + prefs + recipients only) ---
DATABASE_URL=

# --- Vehicle reference privacy ---
# Secret behind the daily rotating salt applied to upstream vehicle references. Rotating the salt
# per service day means a published reference cannot be correlated across days, so the stored data
# describes traffic conditions rather than tracking individual vehicles. Collection refuses to run
# without it rather than storing operator identifiers unsalted.
VEHICLE_SALT_SECRET=

# --- Auth ---
AUTH_SECRET=
AUTH_ALLOWED_ORIGIN=

# --- Email (Daily Brief) ---
# All optional. With none of these set the Daily Brief snapshot is still built and published, and
# the browser view works normally; only email delivery is skipped.
EMAIL_PROVIDER=
EMAIL_PROVIDER_ENDPOINT=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# Secret behind one-click unsubscribe tokens. Only token hashes are stored, so a leaked backup
# cannot be used to unsubscribe anyone or reversed into a list of addresses.
UNSUBSCRIBE_SECRET=

# --- App configuration ---
PUBLIC_BASE_URL=
FEATURE_FLAGS_JSON={}
GOVERNOR_MODE=green

# --- Scheduled intelligence collection (all optional; defaults are in the job) ---
# Current budget utilisation (0..1), published by the worker and passed to scheduled jobs so they
# can widen their cadence or suspend before a limit is reached.
BUDGET_UTILIZATION=
MAX_PARTITIONS_PER_RUN=
BODS_DAILY_REQUEST_BUDGET=
COLLECTION_PASSES=
COLLECTION_BUDGET_MS=
BATCH_BUDGET_MS=
R2_STORAGE_LIMIT_BYTES=
